rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - stores passcode hash (ONE per user)
    match /users/{userId} {
      // Allow reading own passcode hash
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow creating/updating own passcode hash
      allow create, update: if request.auth != null &&
                               request.auth.uid == userId &&
                               request.resource.data.keys().hasAll(['passcodeHash']) &&
                               request.resource.data.keys().hasOnly(['passcodeHash']) &&
                               request.resource.data.passcodeHash is string &&
                               request.resource.data.passcodeHash.size() > 0;
    }

    // Cards collection rules
    match /cards/{cardId} {
      // Allow reading user's own cards
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow creation if the user is authenticated and owns the document and data is valid
      allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.userId &&
                      validateCardData();

      // Allow updating user's own cards with valid data
      allow update: if request.auth != null &&
                      request.auth.uid == resource.data.userId &&
                      request.auth.uid == request.resource.data.userId &&
                      validateCardData();

      // Allow deleting user's own cards
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Other items collection rules
    match /other/{itemId} {
      // Allow reading user's own items
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Allow creation if the user is authenticated and owns the document and data is valid
      allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.userId &&
                      validateOtherData();

      // Allow updating user's own items with valid data
      allow update: if request.auth != null &&
                      request.auth.uid == resource.data.userId &&
                      request.auth.uid == request.resource.data.userId &&
                      validateOtherData();

      // Allow deleting user's own items
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Function to validate card data structure
    function validateCardData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'cardName', 'encryptedBlob']) &&
             data.keys().hasOnly(['userId', 'cardName', 'encryptedBlob']) &&
             data.userId is string &&
             data.cardName is string &&
             data.encryptedBlob is string &&
             data.cardName.size() > 0 &&
             data.cardName.size() <= 100 &&
             data.encryptedBlob.size() > 0;
    }

    // Function to validate other items data structure
    function validateOtherData() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'itemName', 'encryptedBlob']) &&
             data.keys().hasOnly(['userId', 'itemName', 'encryptedBlob']) &&
             data.userId is string &&
             data.itemName is string &&
             data.encryptedBlob is string &&
             data.itemName.size() > 0 &&
             data.itemName.size() <= 100 &&
             data.encryptedBlob.size() > 0;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}